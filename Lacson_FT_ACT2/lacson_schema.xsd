<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <xsd:element name="portfolio">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="student" type="studentType"/>
        <xsd:element name="education" type="educationType" minOccurs="0"/>
        <xsd:element name="skills" type="skillsType" minOccurs="0"/>
        <xsd:element name="projects" type="projectsType" minOccurs="0"/>
        <xsd:element name="awards" type="awardsType" minOccurs="0"/>
        <xsd:element name="statement" type="xsd:string" minOccurs="0"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <xsd:simpleType name="id10digits">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="\d{10}"/>
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:complexType name="studentType">
    <xsd:sequence>
      <xsd:element name="firstname" type="xsd:string"/>
      <xsd:element name="lastname" type="xsd:string"/>
      <xsd:element name="studentid" type="id10digits"/>
      <xsd:element name="course" type="xsd:string"/>
      <xsd:element name="email" type="xsd:string"/>
      <xsd:element name="phone" type="xsd:string" minOccurs="0"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="educationType">
    <xsd:sequence>
      <xsd:element name="school" maxOccurs="unbounded">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="name" type="xsd:string"/>
            <xsd:element name="degree" type="xsd:string"/>
            <xsd:element name="year" type="xsd:gYear" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="skillsType">
    <xsd:sequence>
      <xsd:element name="skill" type="xsd:string" maxOccurs="unbounded"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="projectsType">
    <xsd:sequence>
      <xsd:element name="project" maxOccurs="unbounded">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="title" type="xsd:string"/>
            <xsd:element name="description" type="xsd:string" minOccurs="0"/>
            <xsd:element name="year" type="xsd:gYear" minOccurs="0"/>
            <xsd:element name="link" type="xsd:anyURI" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="awardsType">
    <xsd:sequence>
      <xsd:element name="award" maxOccurs="unbounded">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="title" type="xsd:string"/>
            <xsd:element name="year" type="xsd:gYear" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>

</xsd:schema>
